# Copy to .env, fill in real values, then `source .env`.
# NEVER commit the real .env. No real password ever belongs in Git.

# --- Database (PostgreSQL) ---
# Reactive runtime access (R2DBC):
export R2DBC_URL="r2dbc:postgresql://localhost:5432/security_db"
# Flyway migrations run over plain JDBC at start-up (R2DBC cannot run migrations):
export DB_JDBC_URL="jdbc:postgresql://localhost:5432/security_db"
export DB_USERNAME="msagro"
export DB_PASSWORD="msagro_local"

# --- JWT ---
# Long, random, Base64-encoded secret. At least 32 bytes (256 bits) after decoding, for HS256.
# Generate one with: openssl rand -base64 48
export JWT_SECRET="replace_with_a_long_random_base64_secret"
export JWT_ISSUER="ms-security"
export JWT_ACCESS_TOKEN_MINUTES="15"
export JWT_REFRESH_TOKEN_DAYS="7"

# --- Account policy ---
export MAX_FAILED_ATTEMPTS="5"
export LOCK_MINUTES="15"
export PASSWORD_RESET_MINUTES="30"
# Local testing only. Leave false anywhere the reset token must travel by e-mail.
export EXPOSE_RESET_TOKEN="false"
export DEFAULT_ROLE_CODE="USER"
export REQUIRE_PASSWORD_CHANGE_ON_REGISTER="false"

# --- First administrator (turn off after the account exists) ---
export BOOTSTRAP_ADMIN_ENABLED="false"
export BOOTSTRAP_ADMIN_USERNAME="admin"
export BOOTSTRAP_ADMIN_PASSWORD=""
export BOOTSTRAP_ADMIN_EMAIL="admin@msagro.local"

# --- Server ---
export SERVER_PORT="8080"
export CORS_ALLOWED_ORIGINS="*"
export OPENAPI_SERVER_URL=""
export LOG_LEVEL="INFO"
